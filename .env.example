# Local development overrides. Copy this file to .env and adjust values.

# Spring profile: local or prod
CN_PROFILE=local

# HTTP port used by the application
SERVER_PORT=8080

# Directory that stores the local H2 database files
CN_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Docker Compose with the MySQL profile (optional)
# Copy this file to .env, then replace every change-me value before use.
# ---------------------------------------------------------------------------
MYSQL_DATABASE=collabnexus
MYSQL_USER=collabnexus
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
